/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running on simulated datasets only
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run on simluated datasets only

    Use as follows:
        nextflow run main.nf -profile real_data,<docker/singularity>

----------------------------------------------------------------------------------------
*/

params {
  config_profile_name         = 'Simluated Data Profile'
  config_profile_description  = 'Evaluation on simulated datasets only'

  runDownstreamAnalysis       = false // Skip downstream analysis
  // Full test mode, run all methods and all data
  //samplesheet                 = "${params.data_dir}/samplesheet_simulated_data.csv"
  skip_cplr                   = false
  skip_diablo                 = false
  skip_rgcca                  = false
  skip_mogonet                = false
  skip_mofa                   = false
  // Run feature selection
  select_feature              = true
  k_fold_number               = 5
  // Skip on filtering low variance features
  filter_low_var              = "0" // This get casted as boolean in both Python and R
  // number of components
  num_comps                   = 1

  // GPU-specific array sizing strategy
  // Rule: Small arrays for GPU jobs to avoid GPU queue bottlenecks
  gpu_array_size              = 20    // Small arrays for GPU jobs
  gpu_max_concurrent_arrays   = 10    // Limit concurrent GPU arrays
  
  // CPU array sizes (can be larger)
  cpu_generic_array_size      = 50
  cpu_preprocess_array_size   = 50
  cpu_training_array_size     = 200
  cpu_prediction_array_size   = 200
  feature_selection_array_size = 50
}

// Helper function for dynamic memory calculation - Robust version
def getDynamicMemory(baseMemory, task, additionalFactor = 1) {
    def inputSize = 0
    try {
        inputSize = task.input.collect { input ->
            if (input instanceof java.nio.file.Path) {
                return input.size()
            } else if (input instanceof String) {
                def f = file(input)
                return f.exists() ? f.size() : 0
            } else if (input.hasProperty('size')) {
                return input.size()
            } else {
                return 0
            }
        }.sum() ?: 0
    } catch (Exception e) {
        // Fallback to a reasonable default size
        inputSize = 100 * 1024 * 1024 // 100MB in bytes
    }
    def scaleFactor = 1
    
    // Safe threshold conversion with fallbacks
    def convertToBytes = { param, defaultBytes ->
        try {
            if (param instanceof String) {
                return param.toBytes()
            } else if (param instanceof Number) {
                return param
            } else {
                // Try calling toBytes() method (for MemoryUnit objects)
                return param.toBytes()
            }
        } catch (Exception e) {
            return defaultBytes
        }
    }
     // Define thresholds with safe conversion and sensible defaults
    def smallThreshold = convertToBytes(params.small_dataset_threshold, 10 * 1024 * 1024)      // 10MB default
    def mediumThreshold = convertToBytes(params.medium_dataset_threshold, 100 * 1024 * 1024)   // 100MB default  
    def largeThreshold = convertToBytes(params.large_dataset_threshold, 1024 * 1024 * 1024)    // 1GB default
    
    if (inputSize < smallThreshold) {
        scaleFactor = 1
    } else if (inputSize < mediumThreshold) {
        scaleFactor = 2
    } else if (inputSize < largeThreshold) {
        scaleFactor = 4
    } else {
        scaleFactor = 8
    }
    
    def attemptFactor = task.attempt
    return check_max(baseMemory * scaleFactor * additionalFactor * attemptFactor, 'memory')
}

process {
    maxRetries  = 3
    // Need to include -1 status since large datasets could lead to permission denied error from accesing root
    errorStrategy = { task.exitStatus in [-1,140,143,137,104,134,139,71,255] ? 'retry' : 'finish' }
    scratch = false
    clusterOptions = "--account=${params.allocation_code} --nodes=1"
    
    withLabel: 'gpu' {
        beforeScript = """
        module load gcc
        module load cuda
        """.stripIndent()
        clusterOptions = "--account=${params.allocation_code}-gpu --gpus-per-node=1 --nodes=1"
        containerOptions = {
            workflow.containerEngine == "apptainer" ? '--nv':
            ( workflow.containerEngine == "docker" ? '--gpus all': null )
        }
    }

    // MOGONET with SMALL GPU arrays (critical for limited GPU resources)
    withName: 'MOGONET_TRAIN|MOGONET_SELECT_FEATURE' {
        array  = params.gpu_array_size
        label  = 'gpu'
        memory = '2.GB'
        cpus = 1
        time = { check_max( 1.h  * task.attempt, 'time'    ) }
        maxRetries = 3
        
        errorStrategy = { 
            if (task.exitStatus in [124, 125, 137]) {
                sleep(Math.pow(2, task.attempt) * 200 as long)
                return 'retry'
            }
            return 'finish'
        }
        stageInMode = 'copy'
    }

    // Feature selection (CPU-only, can use moderate arrays)
    withName: '.*_SELECT_FEATURE' {
        array  = params.feature_selection_array_size
        memory = { getDynamicMemory(4.GB, task, 2) }
        cpus = 1
        time = { check_max( 2.h  * task.attempt, 'time'   ) }
        errorStrategy = { sleep(Math.pow(2, task.attempt) * 200 as long); return 'retry' }
        maxRetries = 4
        stageInMode = 'copy'
    }

    // Training processes (mostly CPU, can use larger arrays)
    withName: '.*_TRAIN' {
        array  = params.cpu_training_array_size
        memory = { getDynamicMemory(3.GB, task, 1.5) }
        cpus = 1
        time = { check_max( 2.h  * task.attempt, 'time'   ) }
        errorStrategy = { sleep(Math.pow(2, task.attempt) * 200 as long); return 'retry' }
        stageInMode = 'copy'
    }
    // Data preparation (CPU-only, can use larger arrays)
    withName: 'UNCOMPRESS_RECORD' {
        array  = params.cpu_generic_array_size
        memory = { getDynamicMemory(512.MB, task) }
        cpus = 1
        time = '30.min'
        errorStrategy = { sleep(Math.pow(2, task.attempt) * 200 as long); return 'retry' }
    }

    withName: '.*PREPARE_.*' {
        array  = params.cpu_generic_array_size
        memory = { getDynamicMemory(2.GB, task) }
        cpus = 1
        time = '30.min'
        errorStrategy = { sleep(Math.pow(2, task.attempt) * 200 as long); return 'retry' }
    }
    // For splitting data
        withName: '.*SPLIT_TRAIN_TEST' {
        array  = params.cpu_generic_array_size
        memory = { getDynamicMemory(256.MB, task) }
        cpus = 1
        time = '10.min'
        errorStrategy = { sleep(Math.pow(2, task.attempt) * 200 as long); return 'retry' }
    }

    // Prediction processes (mostly CPU, can use larger arrays)
    withName: '.*_PREDICT' {
        array  = params.cpu_generic_array_size
        memory = { getDynamicMemory(1.GB, task) }
        cpus = 1
        time = '1.h'
        errorStrategy = { sleep(Math.pow(2, task.attempt) * 200 as long); return 'retry' }
    }

    // Preprocess processes
    withName: '.*_PREPROCESS' {
        array  = params.cpu_preprocess_array_size 
        memory = { getDynamicMemory(2.GB, task, 1.2) }
        cpus = 1
        time = '1.h'
        errorStrategy = { sleep(Math.pow(2, task.attempt) * 200 as long); return 'retry' }

    }

    // Keep merge table as single job
    withName: 'MERGE_RESULT_TABLE' {
        memory = '1.GB'
        cpus = 1
        time = '2.h'
    }
}

executor {
    name = 'slurm'
    pollInterval = '45 sec'
    queueSize = 60                
    submitRateLimit = '20/1min'   // Balanced submission rate
    jobName = { "${task.process.split(':').last()}" }
}

profiles {
    debug {
        cleanup = false
    }
    
    
    // Profile for development/testing
    dev {
        params {
            gpu_array_size              = 3
            cpu_training_array_size     = 5
            cpu_prediction_array_size   = 8
            feature_selection_array_size = 3
        }
    }
}

