/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running on simulated datasets only
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run on simluated datasets only

    Use as follows:
        nextflow run main.nf -profile real_data,<docker/singularity>

----------------------------------------------------------------------------------------
*/

params {
  config_profile_name         = 'Simluated Data Profile'
  config_profile_description  = 'Evaluation on simulated datasets only'

  runDownstreamAnalysis       = false // Skip downstream analysis
  // Full test mode, run all methods and all data
  //samplesheet                 = "${params.data_dir}/samplesheet_simulated_data.csv"
  skip_cplr                   = false
  skip_diablo                 = false
  skip_rgcca                  = false
  skip_mogonet                = false
  skip_mofa                   = false
  // Run feature selection
  select_feature              = true
  k_fold_number               = 5
  // Skip on filtering low variance features
  filter_low_var              = "0" // This get casted as boolean in both Python and R

  // GPU-specific array sizing strategy
  // Rule: Small arrays for GPU jobs to avoid GPU queue bottlenecks
  gpu_array_size              = 20    // Small arrays for GPU jobs
  gpu_max_concurrent_arrays   = 10    // Limit concurrent GPU arrays
  
  // CPU array sizes (can be larger)
  cpu_generic_array_size      = 100
  cpu_preprocess_array_size   = 50
  cpu_training_array_size     = 300
  cpu_prediction_array_size   = 300
  feature_selection_array_size = 100
}

process {
    maxRetries  = 3
    errorStrategy = { task.exitStatus in [143,137,104,134,139,71,255] ? 'retry' : 'finish' }
    scratch = false

    clusterOptions = "--account=${params.allocation_code} --nodes=1"
    
    withLabel: 'gpu' {
        beforeScript = """
        module load gcc
        module load cuda
        """.stripIndent()
        clusterOptions = "--account=${params.allocation_code}-gpu --gpus-per-node=1 --nodes=1"
        containerOptions = {
            workflow.containerEngine == "apptainer" ? '--nv':
            ( workflow.containerEngine == "docker" ? '--gpus all': null )
        }
    }

    // MOGONET with SMALL GPU arrays (critical for limited GPU resources)
    withName: 'MOGONET_TRAIN|MOGONET_SELECT_FEATURE' {
        array  = params.gpu_array_size
        label  = 'gpu'
        memory = '2.GB'
        cpus = 1
        time = { check_max( 1.h  * task.attempt, 'time'    ) }
        maxRetries = 3
        
        errorStrategy = { 
            if (task.exitStatus in [124, 125, 137]) {
                sleep(Math.pow(2, task.attempt) * 200 as long)
                return 'retry'
            }
            return 'finish'
        }
        stageInMode = 'copy'
    }

    // Feature selection (CPU-only, can use moderate arrays)
    withName: '.*_SELECT_FEATURE' {
        array  = params.feature_selection_array_size
        memory = { getDynamicMemory(4.GB, task, 2) }
        cpus = 1
        time = { check_max( 1.h  * task.attempt, 'time'   ) }
        errorStrategy = { 
            if (task.exitStatus == 137) {
                log.warn "Feature selection ${task.process} ran out of memory, retrying with more resources"
                sleep(Math.pow(2, task.attempt) * 400 as long)
                return 'retry'
            }
            return task.exitStatus in [143,104,134,139] ? 'retry' : 'finish'
        }
        maxRetries = 4
        stageInMode = 'copy'
    }

    // Training processes (mostly CPU, can use larger arrays)
    withName: '.*_TRAIN' {
        array  = params.cpu_training_array_size
        memory = { getDynamicMemory(3.GB, task, 1.5) }
        cpus = 1
        time = { check_max( 1.h  * task.attempt, 'time'   ) }
        errorStrategy = { 
            if (task.exitStatus == 137) {
                log.warn "Training process ${task.process} ran out of memory, retrying with more resources"
                sleep(Math.pow(2, task.attempt) * 300 as long)
                return 'retry'
            }
            return 'retry'
        }
        stageInMode = 'copy'
    }

    // // Cooperative learning (CPU-only, moderate arrays)
    // withName: 'COOPERATIVE_LEARNING.*' {
    //     array  = params.cpu_preproces_array_size
    //     memory = { getDynamicMemory(4.GB, task, 2) }
    //     cpus = 8
    //     time = '4.h'
    //     errorStrategy = { 
    //         if (task.exitStatus == 137) {
    //             log.warn "Cooperative learning ${task.process} ran out of memory, retrying with more resources"
    //             sleep(Math.pow(2, task.attempt) * 400 as long)
    //             return 'retry'
    //         }
    //         return 'retry'
    //     }
    //     maxRetries = 5
    // }

    // Data preparation (CPU-only, can use larger arrays)
    withName: 'UNCOMPRESS_RECORD' {
        array  = params.cpu_generic_array_size
        memory = { getDynamicMemory(512.MB, task) }
        cpus = 1
        time = '30.min'
        errorStrategy = { sleep(Math.pow(2, task.attempt) * 200 as long); return 'retry' }
    }

    withName: '.*PREPARE_.*' {
        array  = params.cpu_generic_array_size
        memory = { getDynamicMemory(2.GB, task) }
        cpus = 1
        time = '30.min'
        errorStrategy = { sleep(Math.pow(2, task.attempt) * 200 as long); return 'retry' }
    }
    // For splitting data
        withName: '.*SPLIT_TRAIN_TEST' {
        array  = params.cpu_generic_array_size
        memory = { getDynamicMemory(256.MB, task) }
        cpus = 1
        time = '10.min'
        errorStrategy = { sleep(Math.pow(2, task.attempt) * 200 as long); return 'retry' }
    }

    // Prediction processes (mostly CPU, can use larger arrays)
    withName: '.*_PREDICT' {
        array  = params.cpu_generic_array_size
        memory = { getDynamicMemory(1.GB, task) }
        cpus = 1
        time = '1.h'
    }

    // Preprocess processes
    withName: '.*_PREPROCESS' {
        array  = params.cpu_preprocess_array_size 
        memory = { getDynamicMemory(2.GB, task, 1.2) }
        cpus = 1
        time = '1.h'

    }

    // Keep merge table as single job
    withName: 'MERGE_RESULT_TABLE' {
        memory = '1.GB'
        cpus = 1
        time = '2.h'
    }

    // Enhanced error handling
    errorStrategy = { 
        if (task.exitStatus == 137) {
            println "Process ${task.process} ran out of memory, retrying with more resources"
            return 'retry'
        } else if (task.exitStatus == 143) {
            println "Process ${task.process} timed out, retrying with more time"
            return 'retry'
        } else if (task.exitStatus in [130..145, 104]) {
            return 'retry'
        } else {
            return 'finish'
        }
    }
}

executor {
    name = 'slurm'
    pollInterval = '30 sec'
    queueSize = 100                
    submitRateLimit = '10/1min'   // Balanced submission rate
    jobName = { "${task.process.split(':').last()}" }
}

profiles {
    debug {
        cleanup = false
    }
    
    
    // Profile for development/testing
    dev {
        params {
            gpu_array_size              = 3
            cpu_training_array_size     = 5
            cpu_prediction_array_size   = 8
            feature_selection_array_size = 3
        }
    }
}

