/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run main.nf -profile test_full,<docker/singularity>

----------------------------------------------------------------------------------------
*/

params {
  config_profile_name         = 'Full test profile'
  config_profile_description  = 'Full test dataset to check pipeline function'

  // Limit resources so that this can run on GitHub Actions
  max_cpus   = 2
  max_memory = '6.GB'
  max_time   = '6.h'
  // Input data, still runs on 1 data, but on all methods
  input                       = 'data/testdata/full/Samplesheet.csv'

  // Full test mode, run all methods and all data
  samplesheet                 = "${params.data_dir}/samplesheet_test_full.csv"
  skip_cplr                   = false
  skip_diablo                 = false
  skip_rgcca                  = false
  skip_mogonet                = false
  skip_mofa                   = false
  // Run feature selection
  select_feature              = true
  k_fold_number               = 5
}