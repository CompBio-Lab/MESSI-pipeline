// Processes of the MESSI method '{{ method }}'.
// Generated by bin/adding_method/add_method.py. You should not need to edit this file.
//
// All four processes live in this one main.nf on purpose: Nextflow puts
// <folder of main.nf>/resources/usr/bin on PATH, so they all see the same
// {{ method }}_core.{{ ext }}.
//
// The file names under output: are the contract with the wrappers. If a wrapper
// did not write one of them, Nextflow fails the task.

include { getPublishPath } from "${modulesDir}/functions"

// Reads the MAE/MuData and the shared fold split, writes one folder per fold.
process {{ METHOD }}_PREPROCESS {
  tag "${dataset_name}"
  label '{{ method }}'
  label 'process_low'

  publishDir (
    path: "${params.outdir}/${getPublishPath(task.process)}/${dataset_name}",
    mode: 'copy',
    overwrite: true
  )

  input:
    tuple val(dataset_name), path(data_path), path(split_dir)
  output:
    tuple val(dataset_name), path("fold_*", type: 'dir'),               emit: fold_splits
    tuple val(dataset_name), path("${dataset_name}-preprocess.log"),    emit: log

  script:
    """
    messi_run.{{ ext }} preprocess \\
      --method={{ method }} \\
      --data_path=${data_path} \\
      --split_dir=${split_dir} > \\
      ${dataset_name}-preprocess.log
    """
  stub:
    """
    mkdir -p fold_1 fold_2
    touch fold_1/train.{{ data_ext }} fold_1/test.{{ data_ext }}
    touch fold_2/train.{{ data_ext }} fold_2/test.{{ data_ext }}
    echo stub > ${dataset_name}-preprocess.log
    """
}

// Calls fit() on the train part of one fold.
process {{ METHOD }}_TRAIN {
  tag "${dataset_name}-${fold_path.name}"
  label '{{ method }}'
  label 'process_medium'

  publishDir (
    path: "${params.outdir}/${getPublishPath(task.process)}/${dataset_name}/${fold_path.name}",
    mode: 'copy',
    overwrite: true
  )

  input:
    tuple val(dataset_name), path(fold_path)
  output:
    tuple val(dataset_name), val(fold_path.name), path("${dataset_name}-${fold_path.name}-model.{{ data_ext }}"),      emit: model
    tuple val(dataset_name), val(fold_path.name), path("${dataset_name}-${fold_path.name}-test_data.{{ data_ext }}"),  emit: test_data
    tuple val(dataset_name), val(fold_path.name), path("${dataset_name}-${fold_path.name}-train.log"),                 emit: log

  script:
    def label = "${dataset_name}-${fold_path.name}"
    """
    messi_run.{{ ext }} train \\
      --method={{ method }} \\
      --fold_path=${fold_path} \\
      --seed_label=${label} \\
      --model_out=${label}-model.{{ data_ext }} \\
      --test_out=${label}-test_data.{{ data_ext }} > \\
      ${label}-train.log
    """
  stub:
    def label = "${dataset_name}-${fold_path.name}"
    """
    touch ${label}-model.{{ data_ext }} ${label}-test_data.{{ data_ext }}
    echo stub > ${label}-train.log
    """
}

// Calls predict_proba() on the test part of one fold and writes the result table.
process {{ METHOD }}_PREDICT {
  tag "${dataset_name}-${fold_name}"
  label '{{ method }}'
  label 'process_low'

  publishDir (
    path: "${params.outdir}/${getPublishPath(task.process)}/${dataset_name}/${fold_name}",
    mode: 'copy',
    overwrite: true
  )

  input:
    tuple val(dataset_name), val(fold_name), path(model_path), path(test_path)
    val(method_name)
  output:
    tuple val(dataset_name), val(fold_name), val(method_name), path("${dataset_name}-${fold_name}-result.csv"),   emit: result_table
    tuple val(dataset_name), val(fold_name), val(method_name), path("${dataset_name}-${fold_name}-predict.log"),  emit: log

  script:
    def label = "${dataset_name}-${fold_name}"
    """
    messi_run.{{ ext }} predict \\
      --method=${method_name} \\
      --model_path=${model_path} \\
      --test_path=${test_path} \\
      --dataset=${dataset_name} \\
      --fold=${fold_name} \\
      --result_out=${label}-result.csv > \\
      ${label}-predict.log
    """
  stub:
    def label = "${dataset_name}-${fold_name}"
    """
    echo 'sample_name,y,phat,method_name,dataset,fold' > ${label}-result.csv
    echo 's1,0,0.2,${method_name},${dataset_name},${fold_name}' >> ${label}-result.csv
    echo 's2,1,0.8,${method_name},${dataset_name},${fold_name}' >> ${label}-result.csv
    echo stub > ${label}-predict.log
    """
}

// Calls fit() on all samples, then feature_weights().
process {{ METHOD }}_SELECT_FEATURE {
  tag "${dataset_name}"
  label '{{ method }}'
  label 'process_high'

  publishDir (
    path: "${params.outdir}/${task.process.tokenize(':').join('/').toLowerCase()}/${dataset_name}",
    mode: 'copy',
    overwrite: true
  )

  input:
    tuple val(dataset_name), path(data_path)
  output:
    path("{{ method }}-${dataset_name}_features_selected.csv"),          emit: features
    path("{{ method }}-${dataset_name}_selected_hyperparameters.json"),  emit: hyperparameters
    path("{{ method }}-${dataset_name}.log"),                            emit: log

  script:
    """
    messi_run.{{ ext }} select_feature \\
      --method={{ method }} \\
      --data_path=${data_path} \\
      --dataset=${dataset_name} \\
      --features_out={{ method }}-${dataset_name}_features_selected.csv \\
      --hyperparameters_out={{ method }}-${dataset_name}_selected_hyperparameters.json > \\
      {{ method }}-${dataset_name}.log
    """
  stub:
    """
    echo 'feature,view,coef,method,dataset_name' > {{ method }}-${dataset_name}_features_selected.csv
    echo 'f1,view_a,0.5,{{ method }},${dataset_name}' >> {{ method }}-${dataset_name}_features_selected.csv
    echo '{"dataset":"${dataset_name}","method":"{{ method }}","analysis_stage":"model_selection","parameters":{"stub":{"value":1,"treatment":"fixed"}}}' > {{ method }}-${dataset_name}_selected_hyperparameters.json
    echo stub > {{ method }}-${dataset_name}.log
    """
}
