// Cross validation of the MESSI method '{{ method }}'.
// Generated by bin/adding_method/add_method.py. You should not need to edit this file.

include { {{ METHOD }}_PREPROCESS; {{ METHOD }}_TRAIN; {{ METHOD }}_PREDICT } from "${modulesDir}/{{ method }}"
include { MERGE_RESULT_TABLE } from "${modulesDir}/merge_result_table"

def method_name = "{{ method }}"
def saveMode = "method"

workflow {{ METHOD }} {
  take:
    data_copy // channel of [ dataset_name, path to {{ data_kind }}, folder with the fold_*.txt test indices ]

  main:
    // 1. One folder per fold, each with its train and test part
    {{ METHOD }}_PREPROCESS ( data_copy )
    {{ METHOD }}_PREPROCESS.out.fold_splits
        .transpose()
        .set { train_input } // channel of [ dataset_name, fold folder ]

    // 2. Train one model per fold
    {{ METHOD }}_TRAIN ( train_input )
    {{ METHOD }}_TRAIN.out.model
        .join( {{ METHOD }}_TRAIN.out.test_data, by: [0, 1] )
        .set { predict_input } // channel of [ dataset_name, fold_name, model, test data ]

    // 3. Predict the test part of each fold
    {{ METHOD }}_PREDICT ( predict_input, Channel.value(method_name) )

    // 4. Merge the folds of all datasets into one table for this method
    {{ METHOD }}_PREDICT.out.result_table
        .groupTuple(by: 2)
        .map { it -> [ it[2], it[3] ] } // channel of [ method name, list of result tables ]
        .set { result_table }
    MERGE_RESULT_TABLE ( result_table, saveMode, params.outcome_type )

  emit:
    csv_results = MERGE_RESULT_TABLE.out.csv_results
}
